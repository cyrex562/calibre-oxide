{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "calibre-oxide",
  "version": "0.1.0",
  "identifier": "com.cyrex.calibre-oxide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "calibre-oxide",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "6e1d9587-da7b-5de4-b46f-8bc2cc356f91"
      }
    }
  }
}
